generateHistogram<-function(img){
red<-img[,,1]
green<-img[,,2]
blue<-img[,,3]
#Red
r_img<-do.call(rbind,as.list(red))
r_img<-as.vector(r_img)
r_img<-r_img*255
r<-hist(r_img,breaks=seq(0,255,1))
r<-r$mids
#Green
g_img<-do.call(rbind,as.list(green))
g_img<-as.vector(g_img)
g_img<-g_img*255
g<-hist(g_img,breaks=seq(0,255,1))
g<-g$mids
#Blue
b_img<-do.call(rbind,as.list(blue))
b_img<-as.vector(b_img)
b_img<-b_img*255
b<-hist(b_img,breaks=seq(0,255,1))
b<-b$mids
chv<-c(r,g,b)
return(chv)
}
createColorMatrix<-function(){
classI<-1
iterNumber<-1
data.matrix <- matrix(nrow=numberOfFiles,ncol=(255*3)+1)
for(dir in folders){
deeperPath<-paste(path,dir,sep="/")
setwd(deeperPath)
for(image in list.files(deeperPath)){
readImage<-readImage(image)
histo<-generateHistogram(readImage)
data.matrix[iterNumber,1:765]<-histo
data.matrix[iterNumber,766]<-classI
print(histo)
print("====")
print(classI)
print(image)
print(deeperPath)
print(iterNumber)
iterNumber<-iterNumber+1
}
classI<-classI+1
}
}
svmForWhole<-function(){
setwd("/home/konrad/Desktop/Learning/Learning/SVM/images")
path <- getwd()
folders<-list.files()
numberOfFiles<-length(list.files(recursive=TRUE))
colorMatrix<-read.csv("../chv.csv")
colorMatrix<-as.matrix(colorMatrix)
labels<-as.factor(colorMatrix[,767])
colorMatrix<-colorMatrix[,2:766]
index <- 1:nrow(colorMatrix)
testindex <- sample(index, trunc(length(index)/3))
testset <- colorMatrix[testindex,]
testlabels<- labels[testindex]
trainlabels<-labels[-testindex]
trainset <- colorMatrix[-testindex,]
svm.model <- svm(x=trainset,y=trainlabels)
svm.pred <- predict(svm.model,testset)
table(pred = svm.pred, true = testlabels)
}
Npredictions<-function(N){
setwd("/home/konrad/Desktop/Learning/Learning/SVM/images")
path <- getwd()
folders<-list.files()
numberOfFiles<-length(list.files(recursive=TRUE))
colorMatrix<-read.csv("../chv.csv")
colorMatrix<-as.matrix(colorMatrix)
names(colorMatrix)<-NULL
labels<-as.factor(colorMatrix[,767])
trainingMatrix<-matrix(ncol=767)
trainingMatrix<-unname(trainingMatrix)
testMatrix<-matrix(ncol=767)
testMatrix<-unname(testMatrix)
for(i in 1:length(1:length(folders))){
testIndex <- which(colorMatrix[,767]==i)[1:(length(which(colorMatrix[,767]==i))/2)]
trainingIndex<- (max(testIndex)+1):(max(testIndex)+N)
testMatrix<-rbind(testMatrix,colorMatrix[testIndex,])
trainingMatrix<-rbind(trainingMatrix,colorMatrix[trainingIndex,])
}
testMatrix<-testMatrix[2:dim(testMatrix)[1],]
trainingMatrix<-trainingMatrix[2:dim(trainingMatrix)[1],]
trainlabels<-trainingMatrix[,767]
testlabels<-testMatrix[,767]
testMatrix<-testMatrix[,2:766]
trainingMatrix<-trainingMatrix[,2:766]
trainlabels<-as.factor(trainlabels)
svm.model <- svm(x=trainingMatrix,y=trainlabels)
svm.pred <- predict(svm.model,testMatrix)
result<-table(pred = svm.pred, true = testlabels)
return(result)
}
